    "@tiptap/starter-kit": "3.30.1",
    "@tiptap/vue-3": "3.30.1",
    "@unhead/vue": "^3.1.7",
    "axios": "^1.19.0",
    "chart.js": "^4.5.1",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.14",
    "file-saver": "^2.0.5",
    "just-debounce-it": "^3.2.0",
